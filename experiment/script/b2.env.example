# Backblaze B2 credentials for the gsplit-data bucket — TEMPLATE.
#
# Copy to ~/.config/groot/b2.env (OUTSIDE the repo) and fill in real values:
#     mkdir -p ~/.config/groot
#     cp experiment/script/b2.env.example ~/.config/groot/b2.env
#     chmod 600 ~/.config/groot/b2.env
#
# DO NOT COMMIT the filled-in file — the dgl_groot GitHub repo is PUBLIC. Only this
# .example (placeholders) is tracked; ~/.config/groot/b2.env and any *.env are gitignored.
#
# Used by: provision_data.sh / run_split_experiment.sh (B2 push/restore) and
# sync_code.sh --with-creds (copies this to the pod + creates the gsplit-b2 rclone remote).
B2_KEY_ID=<your-backblaze-keyID>
B2_APP_KEY=<your-backblaze-applicationKey>
B2_BUCKET=gsplit-data
B2_BUCKET_ID=<your-bucket-id>
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
